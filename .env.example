DATABASE_URL=postgres://app:CHANGE_ME@localhost:5432/mini_messenger?sslmode=disable
JWT_SECRET_BASE64=REPLACE_WITH_BASE64_OF_32_RANDOM_BYTES
HTTP_ADDR=127.0.0.1:8080
APP_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
SEED_DEMO=false
